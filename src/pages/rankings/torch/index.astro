---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
const slots = Array.from({ length: 5 }, (_, i) => ({
  rank: i + 1,
  name: '調査中',
  long: '未評価',
  repair: '未評価',
  resale: 'データ未収集',
}));
---
<BaseLayout title="10年使いたいガストーチおすすめ5選" description="修理性・部品供給・中古相場を確認して選ぶガストーチ比較ページ。">
  <SiteHeader />
  <main>
    <section class="article-hero"><div class="container narrow">
      <p class="eyebrow">RANKING TEMPLATE / TORCH</p>
      <h1>10年使いたいガストーチ<br />おすすめ5選</h1>
      <p class="lead">修理性・部品供給・残価まで同じ基準で比較。現在は一次調査前のテンプレートで、順位・価格・残価率は未掲載です。</p>
      <p class="data-note">最終データ確認：未実施</p>
    </div></section>
    <section class="section"><div class="container narrow">
      <h2>比較表</h2>
      <div class="table-wrap"><table><thead><tr><th>順位</th><th>製品</th><th>長期指数</th><th>修理指数</th><th>残価</th></tr></thead><tbody>
        {slots.map((item) => <tr><td>{item.rank}</td><td>{item.name}</td><td>{item.long}</td><td>{item.repair}</td><td>{item.resale}</td></tr>)}
      </tbody></table></div>
    </div></section>    <section class="section section-muted"><div class="container narrow">
      <p class="kicker">HOW WE JUDGE</p><h2>掲載前に確認する項目</h2>
      <ul class="check-list">
        <li>発売年・定番歴</li><li>公式修理受付の有無</li><li>交換部品の単品供給</li>
        <li>故障しやすい箇所と分解性</li><li>新品実売価格</li><li>中古の実取引価格と件数</li>
      </ul>
    </div></section>
    <section class="section"><div class="container narrow">
      <p class="kicker">PRODUCT CARTE</p><h2>各商品のカルテ</h2>
      <div class="product-stack">{slots.map((item) => <article class="product-card">
        <span class="rank-label">{item.rank}位候補</span><h3>{item.name}</h3>
        <p>基本スペック、良い点、弱点、故障箇所、修理、部品、中古相場、新品/中古判断、長期メンテナンスを同じ順序で掲載します。</p>
      </article>)}</div>
    </div></section>
  </main>
  <SiteFooter />
</BaseLayout>
