---
import BaseLayout from '../../layouts/BaseLayout.astro';import SiteHeader from '../../components/SiteHeader.astro';import SiteFooter from '../../components/SiteFooter.astro';const base=import.meta.env.BASE_URL;const rows=[['発売','仕様と世代','型番変更、後継機との互換性。'],['所有','傷と消耗','煤、サビ、緩み、劣化。'],['故障','壊れ方','修理可否、交換部品。'],['相場','残り方','新品と中古実取引。']];
---
<BaseLayout title="ギアアーカイブ"><SiteHeader/><main id="main"><section class="page-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">03 / ARCHIVE</p><h1 class="display-tight">道具にも、<br/>履歴書がある。</h1><p class="page-deck">発売、使用、修理、売却までを同じカルテで追う。</p></div><div class="hero-visual"><img src={`${base}visuals/archive-blueprint.svg`} width="1600" height="1000" alt="ギア設計図"/></div></div></section><section class="section-pad dark-section"><div class="shell timeline"><aside><h2 class="section-title">4つの時点を、<br/>追い続ける。</h2></aside><div class="timeline-list">{rows.map(([a,b,c])=><article class="timeline-item"><time>{a}</time><div><h3>{b}</h3><p>{c}</p></div></article>)}</div></div></section></main><SiteFooter/></BaseLayout>
