---
import BaseLayout from '../../layouts/BaseLayout.astro';import SiteHeader from '../../components/SiteHeader.astro';import SiteFooter from '../../components/SiteFooter.astro';const base=import.meta.env.BASE_URL;const rows=[['01','fire','火器・熱源','焚き火台 / バーナー / トーチ / ランタン'],['02','shelter','幕体・寝具','テント / コット / 寝袋'],['03','kitchen','調理・保冷','クーラー / ケトル / クッカー'],['04','furniture','ファニチャー','チェア / テーブル'],['05','tools','ツール・小物','ペグ / ハンマー / 車中泊用品']];
---
<BaseLayout title="カテゴリ"><SiteHeader/><main id="main"><section class="page-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">02 / CATEGORIES</p><h1 class="display-tight">用途ではなく、<br/>残り方まで見る。</h1></div><div class="hero-visual"><img src={`${base}visuals/categories-grid.svg`} width="1600" height="1000" alt="道具分類グリッド"/></div></div></section><section class="section-pad"><div class="shell index-list">{rows.map(([no,id,t,x])=><div class="row" id={id}><span>{no}</span><strong>{t}</strong><p>{x}</p></div>)}</div></section></main><SiteFooter/></BaseLayout>
