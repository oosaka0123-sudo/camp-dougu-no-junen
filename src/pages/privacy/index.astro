---
import BaseLayout from '../../layouts/BaseLayout.astro';import SiteHeader from '../../components/SiteHeader.astro';import SiteFooter from '../../components/SiteFooter.astro';const base=import.meta.env.BASE_URL;
---
<BaseLayout title="プライバシー・広告ポリシー"><SiteHeader/><main id="main"><section class="page-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">POLICY / PRIVACY</p><h1 class="display-tight">信頼は、<br/>見えない場所で決まる。</h1></div><div class="hero-visual"><img src={`${base}visuals/privacy-seal.svg`} width="1600" height="1000" alt="データ保護と透明性の抽象ビジュアル"/></div></div></section><section class="section-pad"><div class="shell"><ol class="policy-list"><li><div><strong>アクセス解析</strong><p>必要以上の個人情報を収集しません。</p></div></li><li><div><strong>広告・アフィリエイト</strong><p>広告を明示し、報酬条件を順位に反映しません。</p></div></li><li><div><strong>外部リンク</strong><p>価格・在庫・条件はリンク先でご確認ください。</p></div></li><li><div><strong>免責</strong><p>修理・分解・火器はメーカー説明と安全指示を優先してください。</p></div></li></ol></div></section></main><SiteFooter/></BaseLayout>
