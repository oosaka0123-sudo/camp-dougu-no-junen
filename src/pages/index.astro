---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const principles = [
  ['Static First', '静的生成で成立するページは静的に。SSRは要件がある部分だけ。'],
  ['Zero-JS', 'HTML/CSSで成立するUIに不要なJavaScriptを送らない。'],
  ['Islands', '動的UIは局所化し、必要なタイミングだけHydrationする。'],
  ['Accessible', 'semantic HTML、キーボード操作、コントラストを標準にする。'],
];
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">ASTRO-FIRST WEB STANDARD</p>
        <h1>速く、軽く、保守しやすいWebを標準から。</h1>
        <p class="lead">コンテンツ中心サイトの共通スターター。Astro標準機能を優先し、依存とクライアントJavaScriptを必要最小限にします。</p>
        <a class="button" href="#start">開始方法を見る</a>
      </div>
    </section>

    <section id="principles" class="section">
      <div class="container">
        <h2>基本方針</h2>
        <div class="grid">
          {principles.map(([title, text]) => (
            <article class="card">
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="start" class="section section-muted">
      <div class="container prose">
        <h2>新規Projectで最初に変更するもの</h2>
        <ol>
          <li><code>SITE_URL</code> と <code>src/config/site.ts</code> を本番値へ変更</li>
          <li>要件を確認し、Static / SSR境界を決定</li>
          <li>反復コンテンツはContent Collectionsへ</li>
          <li><code>npm run check</code> と <code>npm run build</code> を通す</li>
          <li>PC / Mobile / Preview / 公開URLを確認</li>
        </ol>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
